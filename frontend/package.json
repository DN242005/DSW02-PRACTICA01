{
  "name": "empleado-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "cy:login": "cypress run --browser chrome --headless --spec cypress/e2e/authentication.cy.ts",
    "cy:login:headed": "cypress run --e2e --headed --browser chrome --spec cypress/e2e/authentication.cy.ts --config baseUrl=http://localhost",
    "cy:login:local": "cypress run --e2e --headed --browser chrome --spec cypress/e2e/authentication.cy.ts --config baseUrl=http://localhost:4200",
    "cy:login:docker": "docker compose -f ../docker/postgres/docker-compose.yml up -d database backend frontend proxy && cypress run --browser chrome --headless --spec cypress/e2e/authentication.cy.ts --config baseUrl=http://localhost",
    "cy:login:docker:headed": "docker compose -f ../docker/postgres/docker-compose.yml up -d database backend frontend proxy && cypress run --e2e --headed --browser chrome --spec cypress/e2e/authentication.cy.ts --config baseUrl=http://localhost"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "cypress": "^15.14.1",
    "typescript": "^5.9.3"
  }
}
